{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Volt",
  "scopeName": "source.volt",
  "patterns": [
    { "include": "#comment" }, { "include": "#string" }, { "include": "#decl" }, { "include": "#keyword" },
    { "include": "#number" }, { "include": "#builtin-type" }, { "include": "#builtin-fn" }, { "include": "#call" },
    { "include": "#type-name" }, { "include": "#operator" }
  ],
  "repository": {
    "comment": { "name": "comment.line.number-sign.volt", "match": "#.*$" },
    "string": {
      "name": "string.quoted.double.volt", "begin": "\"", "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.volt", "match": "\\\\[ntre\\\\\"{}]" },
        { "name": "meta.interpolation.volt", "begin": "\\{", "end": "\\}", "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.volt" } }, "endCaptures": { "0": { "name": "punctuation.section.embedded.end.volt" } }, "patterns": [{ "include": "$self" }] }
      ]
    },
    "decl": { "patterns": [
      { "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.function.volt" }, "2": { "name": "entity.name.function.volt" } } },
      { "match": "\\b(struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.declaration.type.volt" }, "2": { "name": "entity.name.type.volt" } } },
      { "match": "\\b(test)\\s+(\"[^\"]*\")", "captures": { "1": { "name": "keyword.declaration.test.volt" }, "2": { "name": "entity.name.function.test.volt" } } },
      { "match": "\\b(import)\\s+(c)\\b", "captures": { "1": { "name": "keyword.control.import.volt" }, "2": { "name": "storage.type.volt" } } },
      { "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*)", "captures": { "1": { "name": "keyword.control.import.volt" }, "2": { "name": "entity.name.namespace.volt" } } }
    ] },
    "keyword": { "patterns": [
      { "name": "keyword.control.volt", "match": "\\b(if|else|while|for|in|match|return|break|continue|defer)\\b" },
      { "name": "storage.modifier.volt", "match": "\\b(let|var|mut|link|as)\\b" },
      { "name": "keyword.operator.word.volt", "match": "\\b(and|or|not)\\b" },
      { "name": "constant.language.volt", "match": "\\b(true|false|none)\\b" },
      { "name": "variable.language.self.volt", "match": "\\bself\\b" }
    ] },
    "number": { "patterns": [
      { "name": "constant.numeric.float.volt", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b" },
      { "name": "constant.numeric.integer.volt", "match": "\\b[0-9][0-9_]*\\b" }
    ] },
    "builtin-type": { "name": "support.type.volt", "match": "\\b(int|f64|bool|str|List|Map)\\b" },
    "builtin-fn": { "name": "support.function.builtin.volt", "match": "\\b(print|input|error|exit|assert|sqrt|abs|min|max|pow|sin|cos|tan|exp|log|floor|ceil|atan2|float)\\b(?=\\s*\\()" },
    "call": { "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.call.volt" } } },
    "type-name": { "name": "entity.name.type.volt", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" },
    "operator": { "patterns": [
      { "name": "keyword.operator.arrow.volt", "match": "->|=>" },
      { "name": "keyword.operator.range.volt", "match": "\\.\\." },
      { "name": "keyword.operator.volt", "match": "==|!=|<=|>=|[-+*/%<>=?!]=?" }
    ] }
  }
}
