# std: HTTP-Server. `use http` → http.diene(8080, behandle) mit `fn behandle(a: http.Anfrage) -> http.Antwort`.
# Jede Verbindung läuft in einem eigenen Faden (siehe faden): ein langsamer Client hält die anderen nicht auf.
# Einfach gehalten: HTTP/1.1 ohne Keep-Alive (Connection: close), Kopf bis 16 KB, Inhalt bis 16 MB, Zeitlimit 15 s je Lesevorgang.
use faden
import c "volt_net.h" as n

struct Anfrage
    methode: str
    pfad: str
    anfrage: str       # Text hinter dem `?` (ohne `?`), sonst leer
    kopf: List[str]    # Kopfzeilen im Original ("Host: localhost")
    inhalt: str

    # Wert einer Kopfzeile (Name ohne Beachtung der Groß-/Kleinschreibung).
    fn kopfzeile(self, name: str) -> str?
        let vorn = "{name.lower()}:"
        for z in self.kopf
            if z.lower().starts_with(vorn)
                return z.replace(z.split(":")[0], "").replace(":", "").trim()
        return none

struct Antwort
    status: int = 200
    typ: str = "text/plain; charset=utf-8"
    inhalt: str = ""
    extra: List[str] = List[str]()   # weitere Kopfzeilen, z. B. "Cache-Control: no-store"

fn text(inhalt: str) -> Antwort
    return Antwort(200, "text/plain; charset=utf-8", inhalt)

fn html(inhalt: str) -> Antwort
    return Antwort(200, "text/html; charset=utf-8", inhalt)

fn json(inhalt: str) -> Antwort
    return Antwort(200, "application/json", inhalt)

fn fehler(status: int, meldung: str) -> Antwort
    return Antwort(status, "text/plain; charset=utf-8", meldung)

fn weiter_zu(ziel: str) -> Antwort
    return Antwort(302, "text/plain; charset=utf-8", "weiter zu {ziel}", ["Location: {ziel}"])

fn statustext(status: int) -> str
    if status == 200
        return "OK"
    if status == 201
        return "Created"
    if status == 204
        return "No Content"
    if status == 302
        return "Found"
    if status == 400
        return "Bad Request"
    if status == 404
        return "Not Found"
    if status == 405
        return "Method Not Allowed"
    if status == 413
        return "Payload Too Large"
    if status == 500
        return "Internal Server Error"
    return "Status"

fn senden(fd: int, a: Antwort)
    var kopf = "HTTP/1.1 {a.status} {statustext(a.status)}\r\nContent-Type: {a.typ}\r\nContent-Length: {a.inhalt.len()}\r\nConnection: close\r\n"
    for z in a.extra
        kopf = "{kopf}{z}\r\n"
    n.volt_net_write(fd, "{kopf}\r\n{a.inhalt}")

# Eine Verbindung: Anfrage lesen, `behandle` aufrufen, Antwort schicken, schließen.
fn bediene(fd: int, behandle: fn(Anfrage) -> Antwort)
    let roh = n.volt_net_read_head(fd)
    if roh.len() == 0
        n.volt_net_close(fd)
        return
    let teile = roh.split("\r\n\r\n")
    let kopfteil = teile[0]
    var inhalt = ""
    if teile.len() > 1
        inhalt = roh.replace("{kopfteil}\r\n\r\n", "")
    let zeilen = kopfteil.split("\r\n")
    let erste = zeilen[0].split(" ")
    if erste.len() < 2
        senden(fd, fehler(400, "ungültige Anfrage"))
        n.volt_net_close(fd)
        return
    let ziel = erste[1].split("?")
    var anfrage = ""
    if ziel.len() > 1
        anfrage = ziel[1]
    let kopf = List[str]()
    for i in 1..zeilen.len()
        kopf.push(zeilen[i])
    let a = Anfrage(erste[0], ziel[0], anfrage, kopf, inhalt)
    let laenge = a.kopfzeile("content-length").or("0").to_int().or(0)
    if laenge > 16777216
        senden(fd, fehler(413, "zu groß"))
        n.volt_net_close(fd)
        return
    var voll = a
    if laenge > inhalt.len()
        voll = Anfrage(erste[0], ziel[0], anfrage, kopf, "{inhalt}{n.volt_net_read_body(fd, laenge - inhalt.len())}")
    senden(fd, behandle(voll))
    n.volt_net_close(fd)

# Startet den Server und kehrt nie zurück. `nur_lokal`: nur von diesem Rechner erreichbar.
fn diene_auf(port: int, nur_lokal: bool, behandle: fn(Anfrage) -> Antwort)
    var lokal = 0
    if nur_lokal
        lokal = 1
    let sock = n.volt_net_listen(port, lokal)
    if sock < 0
        print("Port {port} lässt sich nicht öffnen")
        return
    while true
        let verbindung = n.volt_net_accept(sock)
        if verbindung >= 0
            faden.starte_los(fn() => bediene(verbindung, behandle))

fn diene(port: int, behandle: fn(Anfrage) -> Antwort)
    diene_auf(port, false, behandle)
