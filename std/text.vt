# std: Text. `use text` → text.wiederhole("ab", 3), text.fuelle_links("7", 3), text.ist_leer(s) …

fn wiederhole(s: str, n: int) -> str
    var out = ""
    for i in 0..n
        out = "{out}{s}"
    return out

# Füllt links mit Leerzeichen auf `breite` auf ("  7"); ist der Text länger, bleibt er unverändert.
fn fuelle_links(s: str, breite: int) -> str
    return "{wiederhole(" ", max(0, breite - s.len()))}{s}"

fn fuelle_rechts(s: str, breite: int) -> str
    return "{s}{wiederhole(" ", max(0, breite - s.len()))}"

fn ist_leer(s: str) -> bool
    return s.trim().len() == 0

# Wie oft kommt `teil` in `s` vor (ohne Überlappung)? Leerer Teil zählt 0.
fn zaehle(s: str, teil: str) -> int
    if teil.len() == 0
        return 0
    return s.split(teil).len() - 1

test "wiederhole und fuellen"
    assert(wiederhole("ab", 3) == "ababab")
    assert(wiederhole("x", 0) == "")
    assert(fuelle_links("7", 3) == "  7")
    assert(fuelle_rechts("7", 3) == "7  ")
    assert(fuelle_links("lang", 2) == "lang")

test "leer und zaehle"
    assert(ist_leer("   "))
    assert(not ist_leer(" a "))
    assert(zaehle("abcabcab", "ab") == 3)
    assert(zaehle("abc", "") == 0)
