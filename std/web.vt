# std: Browser. `use web` → web.setze_html("#app", "<h1>Hallo</h1>"), web.lausche("#knopf", "click", 1) …
# Ereignisse kommen in `fn ereignis(id: int)` an (id = die Zahl aus `lausche`/`alle`). Zustand liegt in Variablen auf oberster Ebene.
# Beim normalen `volt run` geben die Funktionen ihre Aufrufe nur aus; im Browser (`volt build --target web`, `volt serve`) ändern sie die Seite.
import c "volt_web.h" as w

fn setze_text(selektor: str, text: str)
    w.volt_set_text(selektor, text)

fn setze_html(selektor: str, html: str)
    w.volt_set_html(selektor, html)

fn haenge_an(selektor: str, html: str)
    w.volt_append_html(selektor, html)

fn wert(selektor: str) -> str
    return w.volt_get_value(selektor)

fn setze_wert(selektor: str, neuer_wert: str)
    w.volt_set_value(selektor, neuer_wert)

fn lausche(selektor: str, ereignis: str, id: int)
    w.volt_listen(selektor, ereignis, id)

# Behandler als Funktionswerte: `web.klick("#plus", erhoehen)` – die Funktion hat keine Parameter. Die Nummern ab 100000 gehören
# diesem Modul, kleinere bleiben für `fn ereignis(id: int)` des Programms.
var behandler = List[fn()]()

fn registriere(aktion: fn()) -> int
    behandler.push(aktion)
    return 100000 + behandler.len() - 1

# Komponenten: eine Ansicht ist eine Funktion, die HTML liefert. `web.zeichne("#app", ansicht)` zeigt sie; Knöpfe darin kommen von
# `web.knopf(text, aktion)` und melden ihren Behandler selbst an. Nach jedem Klick wird die Ansicht neu gezeichnet – der Zustand liegt
# in Variablen auf oberster Ebene, die Ansicht liest ihn nur. (Eingabefelder werden dabei neu angelegt: Text vorher mit `web.wert` lesen.)
var ansicht_behandler = List[fn()]()
var aktuelle_ansicht = leere_ansicht
var aktueller_selektor = "#app"

fn leere_ansicht() -> str
    return ""

fn knopf(beschriftung: str, aktion: fn()) -> str
    let nr = ansicht_behandler.len()
    ansicht_behandler.push(aktion)
    return "<button data-volt='{nr}'>{sicher(beschriftung)}</button>"

fn zeichne(selektor: str, ansicht: fn() -> str)
    aktueller_selektor = selektor
    aktuelle_ansicht = ansicht
    aktualisieren()

# Ansicht neu zeichnen (passiert nach jedem `knopf`-Klick von selbst; für Timer und eigene Ereignisse selbst aufrufen).
fn aktualisieren()
    ansicht_behandler.clear()
    let html = aktuelle_ansicht()
    w.volt_set_html(aktueller_selektor, html)
    for i in 0..ansicht_behandler.len()
        w.volt_listen("{aktueller_selektor} [data-volt='{i}']", "click", 200000 + i)

# Vom Browser aufgerufen (id ab 100000).
fn fuehre_aus(id: int)
    if id >= 200000
        let aktion = ansicht_behandler[id - 200000]
        aktion()
        aktualisieren()
    else
        behandler[id - 100000]()

fn bei(selektor: str, ereignis: str, aktion: fn())
    w.volt_listen(selektor, ereignis, registriere(aktion))

fn klick(selektor: str, aktion: fn())
    bei(selektor, "click", aktion)

fn takt(ms: int, aktion: fn())
    w.volt_every(ms, registriere(aktion))

fn alle(ms: int, id: int)
    w.volt_every(ms, id)

fn protokoll(text: str)
    w.volt_log(text)

# Text für HTML unschädlich machen (&, <, >, ").
fn sicher(text: str) -> str
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
