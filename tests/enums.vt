enum Shape
    Circle(radius: f64)
    Rect(w: f64, h: f64)
    Empty

    fn name(self) -> str
        match self
            Circle(r) => "Kreis"
            Rect(w, h) => "Rechteck"
            Empty => "nichts"

fn area(s: Shape) -> f64
    match s
        Circle(r) => 3.0 * r * r
        Rect(w, h) => w * h
        Empty => 0.0

enum Dir
    North
    South

fn main()
    let shapes = [Shape.Circle(2.0), Shape.Rect(2.0, 3.0), Shape.Empty]
    for s in shapes
        print("{s.name()}: {area(s)}")
    let d = Dir.North
    print(d == Dir.North)
    print(d != Dir.South)
    for n in 0..4
        match n % 3
            0 => print("null")
            1
                print("eins")
            _ => print("rest")
    match "ja"
        "nein" => print("falsch")
        "ja" => print("richtig")
        _ => print("?")
