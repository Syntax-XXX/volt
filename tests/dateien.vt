# Dateien, Hashes und Kodierungen aus std/datei.vt – alles in einem Wegwerf-Ordner unter /tmp.
use datei

fn main()
    let w = "/tmp/volt-test-datei-{datei.zufall(4)}"
    assert(datei.ordner_anlegen("{w}/a/b"))
    assert(datei.ist_ordner("{w}/a/b"))
    assert(datei.schreibe("{w}/a/x.txt", "Hallo\nWelt"))
    assert(datei.lies("{w}/a/x.txt") == "Hallo\nWelt")
    assert(datei.groesse("{w}/a/x.txt") == 10)
    assert(datei.ist_datei("{w}/a/x.txt"))
    assert(not datei.existiert("{w}/nix"))
    assert(datei.kopiere("{w}/a", "{w}/c"))
    assert(datei.lies("{w}/c/x.txt") == "Hallo\nWelt")
    assert(datei.benenne_um("{w}/c", "{w}/d"))
    assert(not datei.existiert("{w}/c"))
    let l = datei.liste("{w}/a")
    print("{l.len()} Einträge: {l[0].name} (Ordner: {l[0].ordner}), {l[1].name} ({l[1].groesse} Byte)")
    assert(datei.ordnergroesse(w) == 20)
    assert(datei.loesche(w))
    assert(not datei.existiert(w))
    # Hashes mit bekannten Werten (FIPS 180-2 / RFC 7914)
    print(datei.sha256("abc"))
    datei.schreibe("/tmp/volt-sha-test.txt", "abc")
    assert(datei.sha256_datei("/tmp/volt-sha-test.txt") == datei.sha256("abc"))
    datei.loesche("/tmp/volt-sha-test.txt")
    print(datei.passwort_hash("passwd", "salt", 1))
    assert(datei.gleich("abc", "abc"))
    assert(not datei.gleich("abc", "abd"))
    assert(not datei.gleich("abc", "abcd"))
    print(datei.zufall(8).len())
    print(datei.base64_dekodiere("ZWxpYXM6Z2VoZWlt"))
    print(datei.url_dekodiere("/Mein%20Ordner/%C3%A4.txt"))
    print(datei.url_kodiere("/Mein Ordner/ä.txt"))
    print(datei.http_datum(0))
    print(datei.iso_datum(86400))
    print(datei.jetzt() > 1700000000)
