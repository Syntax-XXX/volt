# Rekursiv und mit Schleife – beide müssen dasselbe ergeben.
fn fib(n: int) -> int
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

fn fib_schnell(n: int) -> int
    var a = 0
    var b = 1
    for i in 0..n
        let next = a + b
        a = b
        b = next
    return a

fn main()
    for n in 0..11
        print("fib({n}) = {fib(n)}")
    print("fib(90) = {fib_schnell(90)}")
