# Generische Funktionen: der Typ T wird aus den Argumenten erkannt, für jeden benutzten Typ entsteht eine eigene
# schnelle Kopie (wie Templates in C++ / Generics in Rust) – ohne Laufzeitkosten.
struct Punkt
    x: int
    y: int

    op <(self, o: Punkt) -> bool
        return self.x + self.y < o.x + o.y

fn groesser[T](a: T, b: T) -> T
    if a < b
        return b
    return a

fn erste[T](liste: List[T]) -> T?
    if liste.len() == 0
        return none
    return liste[0]

fn tausche[A, B](a: A, b: B) -> List[str]
    return ["{a}", "{b}"]

fn summe[T](liste: List[T]) -> T
    var s = liste[0]
    for i in 1..liste.len()
        s = s + liste[i]
    return s

fn anzahl[T](liste: List[T], gesucht: T) -> int
    var n = 0
    for x in liste
        if x == gesucht
            n += 1
    return n

fn main()
    print(groesser(3, 9))
    print(groesser(2.5, 1.5))
    print(groesser("apfel", "birne") == "birne")
    let p = groesser(Punkt(1, 2), Punkt(4, 1))
    print("{p.x},{p.y}")
    print(erste([7, 8, 9]).or(-1))
    print(erste(List[str]()).or("leer"))
    print(tausche(1, "zwei").join(" & "))
    print(summe([1, 2, 3, 4]))
    print(summe([0.5, 0.25]))
    print(anzahl([1, 2, 1, 3, 1], 1))
    print(anzahl(["a", "b", "a"], "a"))
