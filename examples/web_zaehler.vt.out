[web] setze_html #app = <h1>Zähler ⚡</h1><p style='font-size:3rem;margin:.5rem 0' id='zahl'>0</p><button id='plus'>+1</button> <button id='minus'>−1</button> <button id='null'>zurücksetzen</button>
[web] lausche #plus click -> 100000
[web] lausche #minus click -> 100001
[web] lausche #null click -> 100002
